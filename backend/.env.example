# Application
APP_NAME=SNS Manager
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_ORIGINS=["https://app.sns-mgr.app"]
APP_BASE_URL=https://api.sns-mgr.app

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://sns_user:CHANGE_ME@db:5432/sns_manager

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT (RS256 — generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256-GCM Encryption (generate with: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())")
AES_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64_ENCODED
AES_KEY_ID=v1

# Stripe
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# AWS S3 (for media uploads)
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_BUCKET=sns-manager-media
AWS_REGION=ap-northeast-1

# Email (SendGrid)
SENDGRID_API_KEY=SG.CHANGE_ME
FROM_EMAIL=noreply@sns-mgr.app
